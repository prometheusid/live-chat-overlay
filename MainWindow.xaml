<Window x:Class="LiveChatOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Live Chat Overlay"
        Icon="Assets/live-chat.ico"
        Width="360"
        Height="500"
        MinWidth="300"
        MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Border BorderBrush="#9FFFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="8"
                    Background="#F0222730"
                    CornerRadius="8,8,0,0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            Width="18"
                            Height="24"
                            Margin="0,0,6,0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            ToolTip="Drag to move the overlay"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="4" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="4" />
                            </Grid.RowDefinitions>
                            <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="#FFBFC7D1" />
                            <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="#FFBFC7D1" />
                            <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="#FFBFC7D1" />
                            <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="#FFBFC7D1" />
                            <Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2" Fill="#FFBFC7D1" />
                            <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="#FFBFC7D1" />
                        </Grid>
                    </Border>
                    <Button DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Padding="8,4"
                            Content="×"
                            Foreground="#20242B"
                            FontWeight="SemiBold"
                            ToolTip="Close overlay"
                            Click="CloseButton_Click" />
                    <Button DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Padding="8,4"
                            Content="Load"
                            Foreground="#20242B"
                            FontWeight="SemiBold"
                            Click="NavigateButton_Click" />
                    <CheckBox x:Name="ClickThroughCheckBox"
                              DockPanel.Dock="Right"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Foreground="White"
                              Content="Click-through"
                              IsChecked="False"
                              Checked="ClickThrough_Changed"
                              Unchecked="ClickThrough_Changed" />
                    <Grid Margin="0,0,8,0">
                        <TextBox x:Name="UrlBox"
                                 VerticalContentAlignment="Center"
                                 Background="#E6222730"
                                 Foreground="White"
                                 CaretBrush="White"
                                 TextChanged="UrlBox_TextChanged"
                                 KeyDown="UrlBox_KeyDown"
                                 ToolTip="YouTube live chat URL (HTTP or HTTPS)" />
                        <TextBlock x:Name="UrlPlaceholder"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#BFC7D1"
                                   IsHitTestVisible="False"
                                   Text="Paste link here" />
                    </Grid>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="ChatView"
                              DefaultBackgroundColor="Transparent" />
                <TextBlock x:Name="InitialHint"
                           Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="#E6FFFFFF"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Paste a YouTube live chat URL above, then click Load.&#x0a;&#x0a;Press Ctrl+Shift+O to toggle click-through." />
            </Grid>
        </Grid>
    </Border>
</Window>
