<Window x:Class="LiveChatOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Live Chat Overlay"
        Icon="Assets/live-chat.ico"
        Width="360"
        Height="500"
        MinWidth="300"
        MinHeight="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated">
    <Border BorderBrush="#9FFFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="8"
                    Background="#F0222730"
                    CornerRadius="8,8,0,0">
                <Grid>
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left"
                                Width="18"
                                Height="24"
                                Margin="0,0,6,0"
                                Background="Transparent"
                                Cursor="SizeAll"
                                ToolTip="Drag to move the overlay"
                                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="4" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="4" />
                                    <RowDefinition Height="4" />
                                </Grid.RowDefinitions>
                                <Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="#FFBFC7D1" />
                                <Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="#FFBFC7D1" />
                                <Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="#FFBFC7D1" />
                                <Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="#FFBFC7D1" />
                                <Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2" Fill="#FFBFC7D1" />
                                <Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="#FFBFC7D1" />
                            </Grid>
                        </Border>
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="8,4"
                                Content="×"
                                Foreground="#20242B"
                                FontWeight="SemiBold"
                                ToolTip="Close overlay"
                                Click="CloseButton_Click" />
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="8,4"
                                Content="Load"
                                Foreground="#20242B"
                                FontWeight="SemiBold"
                                Click="NavigateButton_Click" />
                        <CheckBox x:Name="ClickThroughCheckBox"
                                  DockPanel.Dock="Right"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Foreground="White"
                                  Content="Click-through"
                                  IsChecked="False"
                                  Checked="ClickThrough_Changed"
                                  Unchecked="ClickThrough_Changed" />
                        <Button x:Name="TextSizeButton"
                                DockPanel.Dock="Right"
                                Margin="0,0,8,0"
                                Padding="6,4"
                                Content="Aa"
                                Foreground="#20242B"
                                FontWeight="SemiBold"
                                ToolTip="Adjust chat text size"
                                Click="TextSizeButton_Click" />
                        <Grid Margin="0,0,8,0">
                            <TextBox x:Name="UrlBox"
                                     VerticalContentAlignment="Center"
                                     Background="#E6222730"
                                     Foreground="White"
                                     CaretBrush="White"
                                     TextChanged="UrlBox_TextChanged"
                                     KeyDown="UrlBox_KeyDown"
                                     ToolTip="YouTube live chat URL (HTTP or HTTPS)" />
                            <TextBlock x:Name="UrlPlaceholder"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#BFC7D1"
                                       IsHitTestVisible="False"
                                       Text="Paste link here" />
                        </Grid>
                    </DockPanel>
                    <Popup x:Name="TextSizePopup"
                           PlacementTarget="{Binding ElementName=TextSizeButton}"
                           Placement="Bottom"
                           StaysOpen="True">
                        <Border Padding="12"
                                Background="#F0222730"
                                BorderBrush="#9FFFFFFF"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6"
                                           Foreground="White"
                                           Text="Chat text size" />
                                <ComboBox x:Name="TextSizeComboBox"
                                          Width="100"
                                          HorizontalAlignment="Left"
                                          SelectedValuePath="Tag"
                                          SelectedIndex="2"
                                          SelectionChanged="TextSizeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="80%" Tag="80" />
                                    <ComboBoxItem Content="90%" Tag="90" />
                                    <ComboBoxItem Content="100%" Tag="100" />
                                    <ComboBoxItem Content="110%" Tag="110" />
                                    <ComboBoxItem Content="120%" Tag="120" />
                                    <ComboBoxItem Content="130%" Tag="130" />
                                    <ComboBoxItem Content="140%" Tag="140" />
                                    <ComboBoxItem Content="150%" Tag="150" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="ChatView"
                              Margin="0,0,14,14"
                              DefaultBackgroundColor="Transparent" />
                <TextBlock x:Name="InitialHint"
                           Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="#E6FFFFFF"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Paste a YouTube live chat URL above, then click Load.&#x0a;&#x0a;Press Ctrl+Shift+O to toggle click-through." />
            </Grid>

            <primitives:Thumb Grid.Row="1"
                              Width="14"
                              Margin="0,8,0,8"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="SizeWE"
                              ToolTip="Drag to resize width"
                              DragDelta="ResizeRight_DragDelta">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Grid>
                            <Border x:Name="Grip"
                                    Width="2"
                                    HorizontalAlignment="Right"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="#99FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
            <primitives:Thumb Grid.Row="1"
                              Height="14"
                              Margin="8,0,8,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom"
                              Background="Transparent"
                              Cursor="SizeNS"
                              ToolTip="Drag to resize height"
                              DragDelta="ResizeBottom_DragDelta">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Grid>
                            <Border x:Name="Grip"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="#99FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
            <primitives:Thumb Grid.Row="1"
                              Width="14"
                              Height="14"
                              Margin="0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Background="Transparent"
                              Cursor="SizeNWSE"
                              ToolTip="Drag to resize"
                              DragDelta="ResizeCorner_DragDelta">
                <primitives:Thumb.Template>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border x:Name="Grip" Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="#99FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </primitives:Thumb.Template>
            </primitives:Thumb>
        </Grid>
    </Border>
</Window>
